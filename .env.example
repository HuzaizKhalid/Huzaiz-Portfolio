# ============================================================
# PORTFOLIO WEBSITE — Supabase Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your Supabase values
# from: Supabase Dashboard → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# ============================================================
# ANALYTICS — admin dashboard ingest endpoint
# ============================================================
# Base URL of the huzaiz-admin deployment. Events are POSTed to
# <this>/api/track and shown at <this>/dashboard/analytics.
# Leave blank to disable tracking entirely.
VITE_ADMIN_API_URL=https://huzaiz-admin.vercel.app
